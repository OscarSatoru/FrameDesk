                </Link>
              </Button>
            </>
          ) : (
            <>
              <h2 className="text-lg font-semibold">לא נמצאו הצעות מתאימות</h2>
              <p className="mx-auto mt-1 max-w-sm text-sm text-muted-foreground">
                נסו לשנות את החיפוש או הסינון כדי למצוא את ההצעה שאתם מחפשים.
              </p>
              {hasActiveFilters && (
                <Button
                  variant="outline"
                  className="mt-6"
