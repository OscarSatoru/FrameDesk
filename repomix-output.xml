          </div>
        </div>

        {/* מפרט פתחים */}
        <div className="my-6 overflow-hidden rounded-md border">
          <table className="w-full text-right text-sm">
            <thead className="border-b bg-muted/60 text-xs font-semibold text-foreground">
              <tr>
